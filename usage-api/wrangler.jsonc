{
  "name": "aura-usage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "ratelimits": [{"name":"LOGIN_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}}],
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://hyperspandan.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aura-usage",
    "database_id": "e35fa467-c2eb-47cd-b426-406c8d114181"
  }]
}

